{
  "name": "@ai-native-forms/server",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "eval:fill": "node --env-file-if-exists=../../apps/playground/.env.local --import tsx scripts/eval-fill.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@ai-native-forms/core": "workspace:*",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "ai": "7.0.91",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@ai-native-forms/examples": "workspace:*",
    "@types/node": "26.4.1",
    "tsx": "^4.23.13"
  }
}
