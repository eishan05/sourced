{
  "name": "@sourced/server",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eishan05/sourced.git",
    "directory": "packages/server"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "eval:fill": "node --env-file-if-exists=../../apps/playground/.env.local --import tsx scripts/eval-fill.ts",
    "test": "vitest run",
    "test:live": "SOURCED_LIVE_TESTS=1 vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@sourced/core": "workspace:*",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "ai": "7.0.91",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@sourced/examples": "workspace:*",
    "@types/node": "26.4.1",
    "tsx": "^4.23.13"
  }
}
