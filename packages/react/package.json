{
  "name": "@ai-native-forms/react",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js"
    },
    "./kit.css": {
      "default": "./kit.css"
    }
